{
  "name": "@hyper-hyper/hyper-server",
  "version": "1.0.3",
  "description": "Another Web Server powered by Bun.",
  "author": {
    "name": "Mikita Stankiewicz",
    "email": "itsmikita@gmail.com",
    "url": "https://github.com/itsmikita"
  },
  "private": "true",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "hyper-server": "./bin/hyper-server",
    "hyper-server-bonjour": "./bin/hyper-server-bonjour"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyper-hyper/hyper-server.git"
  },
  "scripts": {
    "cleanup": "rm -rf node_modules bun.lockb bunfig.toml",
    "dev": "bun ./src/server.js --hot --port 9090 --root ./src",
    "build": "bun build ./src/server.js --compile --minify --outfile bin/hyper-server",
    "install": "ln -sf ./bin/hyper-server ~/.local/bin/hyper-server"
  },
  "dependencies": {
    "@types/bun": "^1.4.4",
    "bonjour-service": "^1.4.4",
    "bun": "^1.4.4",
    "dgram": "^1.0.1"
  }
}
